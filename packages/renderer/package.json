{
  "name": "@bromaid/renderer",
  "version": "0.2.2",
  "description": "Pure-string SVG renderer for @bromaid LayoutGraph (DOM-free, RSC-safe), plus an opt-in interactive client (./client) and React wrapper (./react).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vaarvik/bromaid.git",
    "directory": "packages/renderer"
  },
  "homepage": "https://github.com/vaarvik/bromaid#readme",
  "bugs": {
    "url": "https://github.com/vaarvik/bromaid/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    },
    "./react": {
      "types": "./src/react/index.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "./client": {
        "types": "./dist/client.d.ts",
        "import": "./dist/client.js",
        "require": "./dist/client.cjs"
      },
      "./react": {
        "types": "./dist/react.d.ts",
        "import": "./dist/react.js",
        "require": "./dist/react.cjs"
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bromaid/core": "workspace:*",
    "@bromaid/layout": "workspace:*",
    "@bromaid/theme": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "18.3.28",
    "elkjs": "^0.9.3",
    "happy-dom": "^21.0.4",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
